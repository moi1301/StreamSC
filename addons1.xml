<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addons>
<addon id="StreamSC" name="Stream SC" version="1.2.0" provider-name="Moi">
    
    <extension point="xbmc.python.pluginsource" library="addon.py">
        <provides>video</provides>
    </extension>
    
    <requires>
        <import addon="xbmc.python" version="3.0.1"/>
        <import addon="xbmc.gui" version="5.17.0"/>
        <import addon="script.module.dropbox" version="10.3.1+matrix.1"/>
        <import addon="script.module.requests" version="2.31.0"/>
        <import addon="script.module.urllib3" version="1.26.11"/>
    </requires>

    <extension point="xbmc.addon.metadata">
        <platform>all</platform>
        <license>GPL-3.0-or-later</license>
        <summary lang="es_ES">Lista sincronizada desde Dropbox.</summary>
        <description lang="es_ES">Este complemento se conecta remotamente a un archivo de texto para listar y reproducir sus enlaces correspondientes a través de módulos externos.</description>
        <disclaimer lang="es_ES">El desarrollador no aloja ni distribuye el contenido multimedia reproducido por este complemento.</disclaimer>
        
        <assets>
            <icon>resources/icon.png</icon>
            <fanart>resources/fanart.jpg</fanart>
        </assets>
    </extension>
</addon>
</addons>
